<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content={csrf_token_value()} />
    <.live_title suffix=" · Livebook Notebooks (Elixir)">
      {assigns[:page_title] || "Notesclub"}
    </.live_title>
    <link rel="icon" type="image/png" href={Routes.static_path(@conn, "/images/favicon.png")} />
    <link phx-track-static rel="stylesheet" href={Routes.static_path(@conn, "/assets/app.css")} />
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={Routes.static_path(@conn, "/assets/app.js")}
    >
    </script>
    <script
      defer
      data-domain="notes.club"
      src="https://plausible.io/js/plausible.js"
      integrity="sha384-A/+e8MGB5ruM9qUEz7ST0YKPo2TLEwdHhBIZL1Ii9jqCGKR2ZwLKc6ArNahGzYOV"
      crossorigin="anonymous"
    >
    </script>
  </head>
  <body>
    <div id="return-to-hook" phx-hook="ReturnToHook"></div>
    {@inner_content}
  </body>
</html>
